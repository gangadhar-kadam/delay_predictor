# Bench Configuration for Delay Predictor App
# This file contains configuration for bench commands

[bench]
# Bench directory
bench_dir = /home/frappe/frappe-bench

# Site configuration
site = delay_predictor_site

# App configuration
apps = delay_predictor,erpnext,frappe

# Database configuration
db_host = localhost
db_port = 3306
db_name = delay_predictor_db
db_user = root
db_password = root

# Redis configuration
redis_cache = redis://localhost:13000
redis_queue = redis://localhost:11000

# Worker configuration
workers = 2
max_requests = 1000
timeout = 30

# Logging configuration
log_level = INFO
log_file = /home/frappe/frappe-bench/logs/delay_predictor.log

# Security configuration
secret_key = your-secret-key-here
encryption_key = your-encryption-key-here

# Performance configuration
enable_redis_cache = true
enable_redis_queue = true
enable_redis_socketio = true

# Development configuration
developer_mode = false
auto_update = false
auto_migrate = false

# Production configuration
production = true
maintenance_mode = false
